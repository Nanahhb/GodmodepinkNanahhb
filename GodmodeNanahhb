
-- NANAHHB | DELTA LUA
-- Pastel UI + Humanoid Monitor

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("Nanahhb")
if old then old:Destroy() end

local GOLD = Color3.fromRGB(255, 211, 91)
local CREAM = Color3.fromRGB(255, 248, 224)
local PINK = Color3.fromRGB(255, 177, 204)
local BROWN = Color3.fromRGB(119, 69, 34)

local gui = Instance.new("ScreenGui")
gui.Name = "Nanahhb"
gui.ResetOnSpawn = false
gui.Parent = pg

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(340, 300)
main.Position = UDim2.new(.5, -170, .5, -150)
main.BackgroundColor3 = CREAM
main.Active = true
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 18)

local outline = Instance.new("UIStroke", main)
outline.Color = GOLD
outline.Thickness = 4

local function makeButton(text, x, y, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(.46, 0, 0, 48)
    b.Position = UDim2.new(x, 0, 0, y)
    b.BackgroundColor3 = color
    b.TextColor3 = BROWN
    b.Text = text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = main
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
    return b
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 60)
title.Position = UDim2.fromOffset(10, 10)
title.BackgroundColor3 = GOLD
title.Text = "👑 NANAHHB ✨"
title.TextColor3 = BROWN
title.TextScaled = true
title.Font = Enum.Font.GothamBlack
title.Parent = main
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 12)

local hp = Instance.new("TextLabel")
hp.Size = UDim2.new(1, -20, 0, 28)
hp.Position = UDim2.fromOffset(10, 76)
hp.BackgroundTransparency = 1
hp.TextColor3 = BROWN
hp.TextScaled = true
hp.Font = Enum.Font.GothamBold
hp.Text = "HUMANOID: Waiting..."
hp.Parent = main

local god = makeButton("💗 GODMODE: OFF", .04, 112, GOLD)
local hide = makeButton("🐰 HIDE MENU", .50, 112, PINK)
local teleport = makeButton("☁️ TELEPORT", .04, 170, GOLD)
local refill = makeButton("🧪 REFILL HEALTH", .50, 170, GOLD)

local menu = Instance.new("TextButton")
menu.Size = UDim2.fromOffset(110, 42)
menu.Position = UDim2.new(0, 15, .75, 0)
menu.BackgroundColor3 = GOLD
menu.Text = "🐾 MENU"
menu.TextColor3 = BROWN
menu.TextScaled = true
menu.Font = Enum.Font.GothamBold
menu.Parent = gui
Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 12)

local enabled = false
local connection

local function monitor()
    if connection then
        connection:Disconnect()
        connection = nil
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not hum then
        hp.Text = "HUMANOID: Waiting..."
        return
    end

    local function update()
        hp.Text = string.format(
            "HUMANOID: %.0f / %.0f HP",
            hum.Health, hum.MaxHealth
        )
    end

    update()
    connection = hum.HealthChanged:Connect(update)
end

god.Activated:Connect(function()
    enabled = not enabled
    god.Text = enabled and "💗 GODMODE: ON" or "💗 GODMODE: OFF"
    god.BackgroundColor3 = enabled
        and Color3.fromRGB(255, 190, 112) or GOLD
    monitor()
end)

hide.Activated:Connect(function()
    main.Visible = false
end)

menu.Activated:Connect(function()
    main.Visible = not main.Visible
end)

teleport.Activated:Connect(function()
    teleport.Text = "TELEPORT: N/A"
    task.delay(1.2, function()
        if teleport.Parent then teleport.Text = "☁️ TELEPORT" end
    end)
end)

refill.Activated:Connect(function()
    refill.Text = "HEALTH: MONITOR ONLY"
    task.delay(1.2, function()
        if refill.Parent then refill.Text = "🧪 REFILL HEALTH" end
    end)
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    monitor()
end)

monitor()

-- Drag menu using header
local dragging, dragStart, startPos = false, nil, nil

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

print("NANAHHB loaded!")
