-- Fixed MENU ON/OFF + Humanoid monitor

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("Nanahhb")
if old then old:Destroy() end

local GOLD = Color3.fromRGB(255, 211, 91)
local CREAM = Color3.fromRGB(255, 248, 224)
local PINK = Color3.fromRGB(255, 177, 204)
local BROWN = Color3.fromRGB(119, 69, 34)

local gui = Instance.new("ScreenGui")
gui.Name = "Nanahhb"
gui.ResetOnSpawn = false
gui.Parent = pg

local function corner(obj, radius)
    Instance.new("UICorner", obj).CornerRadius =
        UDim.new(0, radius)
end

local function makeButton(parent, text, size, pos, color)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = color
    b.TextColor3 = BROWN
    b.Text = text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = parent
    corner(b, 10)
    return b
end

local main = Instance.new("Frame")
main.Name = "MainPanel"
main.Size = UDim2.fromOffset(360, 300)
main.Position = UDim2.new(0.5, -180, 0.5, -150)
main.BackgroundColor3 = CREAM
main.Active = true
main.Parent = gui
corner(main, 18)

local border = Instance.new("UIStroke", main)
