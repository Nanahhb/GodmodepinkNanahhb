-- MENU ON/OFF: menu nổi luôn tồn tại
hide.Activated:Connect(function()
    main.Visible = false
end)

menu.Activated:Connect(function()
    main.Visible = not main.Visible
end)

-- Humanoid monitor
local godEnabled = false
local healthConnection
local currentHumanoid

local function monitorHumanoid()
    if healthConnection then
        healthConnection:Disconnect()
        healthConnection = nil
    end

    local character = player.Character
    currentHumanoid = character and
        character:FindFirstChildOfClass("Humanoid")

    if not currentHumanoid then
        hp.Text = "HUMANOID: WAITING..."
        return
    end

    local hum = currentHumanoid

    local function updateHealth()
        if hum.Parent then
            hp.Text = string.format(
                "HUMANOID: %.0f / %.0f HP",
                hum.Health, hum.MaxHealth
            )
        end
    end

    updateHealth()
    healthConnection =
        hum.HealthChanged:Connect(updateHealth)
end

god.Activated:Connect(function()
    godEnabled = not godEnabled
    god.Text = godEnabled and
        "💗 GODMODE: ON" or "💗 GODMODE: OFF"
    god.BackgroundColor3 = godEnabled and
        Color3.fromRGB(255, 190, 112) or GOLD

    monitorHumanoid()
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    monitorHumanoid()
end)

teleport.Activated:Connect(function()
    teleport.Text = "TELEPORT: DEMO"
    task.delay(1, function()
        if teleport.Parent then
            teleport.Text = "☁️ TELEPORT"
        end
    end)
end)

refill.Activated:Connect(function()
    refill.Text = "HEALTH: MONITOR ONLY"
    task.delay(1, function()
        if refill.Parent then
            refill.Text = "🧪 REFILL HEALTH"
        end
    end)
end)

monitorHumanoid()

-- Kéo bảng chính bằng thanh tiêu đề
local dragging = false
local dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

print("NANAHHB loaded - MENU fixed!")
